# ─────────────────────────────────────────────────────────────────────────────
# PharmaStock environment. Copy to .env and fill in. This example is safe to commit (no values).
# Full Supabase steps: docs/DEPLOY-SUPABASE.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Currently: the local Postgres started by scripts/db-local.sh.
# To switch to Supabase, replace these two lines with the Supabase templates below.
DATABASE_URL=
APP_DATABASE_URL=

# Supabase templates (Project → Connect). Replace <PROJECT-REF>, <REGION>, <POSTGRES-PASSWORD>, <APP-DB-PASSWORD>.
# DATABASE_URL = direct connection, user "postgres" (migrations, worker, sign-in). No IPv6 on your host? use the Session pooler URL.
# DATABASE_URL=postgresql://postgres:<POSTGRES-PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
# APP_DATABASE_URL = Transaction pooler (port 6543) as the app role created by `pnpm supabase:setup`.
# APP_DATABASE_URL=postgresql://pharmastock_app.<PROJECT-REF>:<APP-DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# Password for the app role; used once by `pnpm supabase:setup` (16+ random characters), then in APP_DATABASE_URL above.
APP_DB_PASSWORD=

# ── Supabase Storage (files: logos, prescription scans, delivery notes, exports) ─
# Leave SUPABASE_URL empty to keep files on local disk (STORAGE_DIR).
SUPABASE_URL=
# Project Settings → API → service_role key. Server only: never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pharmacy-files
STORAGE_DIR=.storage

# ── App secrets ─────────────────────────────────────────────────────────────
# Encrypts allergies, diagnoses, register addresses and secrets. Back it up; if lost, that data can't be read.
# Use a NEW key for production (openssl rand -base64 32) and keep this one for local dev data.
ENCRYPTION_KEY=
# Public address of the app (used in receipt, supplier-portal and payment links), e.g. https://app.pharmastock.com
APP_URL=http://localhost:3000
# Protects /api/cron/tick (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ── Payments (Paystack): subscriptions and setup services. Webhook: <APP_URL>/api/webhooks/paystack ──
PAYSTACK_SECRET_KEY=

# ── Messaging (leave blank in dev: messages are printed in the server log) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=PharmaStock <no-reply@pharmastock.app>

# ── Ask PharmaStock (plain-language reports; optional) ──────────────────────
ANTHROPIC_API_KEY=
